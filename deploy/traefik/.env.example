# Copy to .env on the vServer and fill in real values.
#
# Note: ACME email is set in traefik.yml (Traefik static config does not
# support env-var interpolation). Edit that file to change it.

# Netcup CCP API credentials (Menü → Stammdaten → Webservice/API)
# Used by Traefik's Netcup DNS-01 provider to solve ACME challenges.
NETCUP_CUSTOMER_NUMBER=
NETCUP_API_KEY=
NETCUP_API_PASSWORD=
