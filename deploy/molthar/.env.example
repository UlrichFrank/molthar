# Copy to .env on the vServer and fill in real values.

# Base for app subdomains. Frontend runs at molthar.$APPS_DOMAIN,
# backend at molthar-api.$APPS_DOMAIN. Wildcard cert covers both.
# Example: APPS_DOMAIN=apps.deinedomain.de
APPS_DOMAIN=apps.example.com

# Image tag to run. Set to a specific git SHA for reproducible/rollback deploys.
# Example: IMAGE_TAG=git-a1b2c3d
IMAGE_TAG=latest
