# Portale von Molthar: game server, NPCs and embedded game page as a single binary.
# Installed to /etc/systemd/system/molthar.service by `make deploy`.
# Traefik (systemd, /etc/traefik) routes to it via the file provider,
# see traefik-molthar.yml.

[Unit]
Description=Portale von Molthar (Spielserver, NPCs und Spielseite)
Documentation=https://github.com/UlrichFrank/portale-von-molthar/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=molthar
Group=molthar
ExecStart=/opt/molthar/molthar
WorkingDirectory=/var/lib/molthar
StateDirectory=molthar
Environment=NODE_ENV=production
# Loopback only: reachable for Traefik on the same host, not from the internet.
# Port 3001 on this address belongs to Ausgebremst.
Environment=HOST=127.0.0.1
Environment=PORT=3002
Environment=MATCHES_DIR=/var/lib/molthar/data
# NPC seat credentials — without them running NPC matches hang
Environment=NPC_DATA_DIR=/var/lib/molthar/data-npc
Environment=MATCH_TTL_DAYS=1
# Socket.IO checks the Origin header even for same-origin pages
Environment=EXTRA_ORIGINS=https://molthar.apps.diefranks.eu
Restart=always
RestartSec=2
TimeoutStopSec=10
MemoryMax=250M

# Hardening (Bun's JIT needs writable+executable memory: no MemoryDenyWriteExecute)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
